{
  "jev-evaluator": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "{{VENV_PYTHON}} {{EVALUATOR_SCRIPT}} --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
